SERVICE_NAME=websocket-gateway
HTTP_ADDR=:8083

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_ride
DB_SSLMODE=disable

KAFKA_BROKERS=localhost:9094
KAFKA_CONSUMER_GROUP=websocket-gateway-group
KAFKA_OFFER_CREATED_TOPIC=driver.job_offer.created.v1
KAFKA_ASSIGNED_TOPIC=ride.assigned.v1
KAFKA_STARTED_TOPIC=ride.started.v1
# Must match location-producers' KAFKA_TOPIC / the root Makefile's LOCATION_TOPIC.
KAFKA_LOCATION_TOPIC=driver.location.updated.v1

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_OFFER_CHANNEL=driver-offers
REDIS_ASSIGNMENT_CHANNEL=ride-assignments
REDIS_LOCATION_CHANNEL=driver-location-updates
REDIS_TRIP_STARTED_CHANNEL=trip-started

JWT_SECRET=changeme
JWT_ISSUER=go-ride-backend
JWT_AUDIENCE=go-ride-driver-app

WS_PING_INTERVAL_SECONDS=20
WS_PONG_WAIT_SECONDS=60
REPLAY_BATCH_SIZE=50

# Must match trip-dispatch-worker's DRIVER_COMMISSION_RATE — replayed offers
# recompute estimated_earning locally rather than reading it off the (already
# consumed) Kafka event.
DRIVER_COMMISSION_RATE=0.20

# Bounds how long a driver->rider active-trip mapping survives in Redis for
# location-stream filtering. No trip-completion/cancellation event exists yet
# to clear it early, so this TTL is the sole expiry mechanism for now.
ACTIVE_TRIP_TTL_SECONDS=7200
