SERVICE_NAME=cab-request-handler
HTTP_ADDR=:8082

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_ride
DB_SSLMODE=disable

KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC=ride.requested.v1

DEFAULT_SEARCH_RADIUS_KM=20
FARE_CURRENCY_CODE=USD
FARE_PRICING_VERSION=v1
FARE_BASE_AMOUNT=5.00
FARE_PER_KM_AMOUNT=1.50
FARE_PER_MINUTE_AMOUNT=0.25
FARE_MINIMUM_AMOUNT=8.00
FARE_AVERAGE_SPEED_KPH=30
FARE_LOCK_TTL_MINUTES=15

# Must match go-ride-backend's JWT_SECRET/JWT_ISSUER — this service only
# verifies rider tokens minted there, it never issues its own.
JWT_SECRET=super-secret-key-change-in-production
JWT_ISSUER=go-ride-backend
JWT_AUDIENCE=go-ride-clients