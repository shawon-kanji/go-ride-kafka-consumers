SERVICE_NAME=trip-dispatch-worker

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_ride
DB_SSLMODE=disable

KAFKA_BROKERS=localhost:9094
KAFKA_CONSUMER_GROUP=trip-dispatch-worker-group
KAFKA_INPUT_TOPIC=ride.requested.v1
KAFKA_ASSIGNED_TOPIC=ride.assigned.v1
KAFKA_UNASSIGNED_TOPIC=ride.unassigned.v1

NEAREST_DRIVERS_LIMIT=10
DRIVER_LOCATION_FRESH_WINDOW_SECONDS=300
DISPATCH_INITIAL_RADIUS_KM=20
DISPATCH_RADIUS_STEP_KM=5
DISPATCH_MAX_RADIUS_KM=30
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_BACKOFF_BASE_SECONDS=2
DISPATCH_BACKOFF_MAX_SECONDS=30
JOB_OFFER_TTL_SECONDS=15
DISPATCH_SWEEP_INTERVAL_SECONDS=3
